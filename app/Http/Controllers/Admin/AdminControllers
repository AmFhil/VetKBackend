    // search stores by name
    public function searchStores(Request $request)
    {
        $query = $request->input('query');
        if (!$query) return response()->json(['stores' => []], 200);

        $stores = Store::where('store_name', 'like', "%$query%")
            ->orWhere('location', 'like', "%$query%")
            ->with('ratings:id,rating,comment,rateable_id')
            ->paginate(10);

        $stores->getCollection()->transform(function ($store) {
            $store->average_rating = $store->averageRating();
            // $store->average_rating = $average ? number_format($average, 1) . ' of 5' : '0 of 5';
            return $store;
        });

        return response()->json(['stores' => $stores], 200);
    }

    // search product
    public function searchProducts(Request $request)
    {
        try {
            $query = $request->input('query');
            if (!$query) return response()->json(['stores' => []], 200);

            $query = Products::with('ratings:id,rating,comment,rateable_id', 'tags')
                ->where('category', 'LIKE', "%{$request->category}%")
                ->where('description', 'LIKE', "%{$request->keyword}%")
                ->orWhere('product_name', 'LIKE', "%{$request->keyword}%");


            $products = $query->paginate(10);

            $products->getCollection()->transform(function ($product) {
                $product->average_rating = $product->averageRating();
                return $product;
            });

            return response()->json(['message' => 'Products retrieved successfully.', 'products' => $products], 200);
        } catch (\Throwable $th) {
            return response()->json(['message' => 'An error occurred while searching.', 'error' => $th->getMessage()], 500);
        }
    }

    // get products
